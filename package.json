{
  "name": "ia-orchestrator-new",
  "version": "1.0.0",
  "description": "Dashboard Desktop pour piloter des agents IA Jules",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.orchestrateur.ia",
    "productName": "Orchestrateur IA",
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "dist/**/*"]
  }
}
